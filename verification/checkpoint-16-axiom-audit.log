      [Fact (Nat.Prime p)] →
        [CharP K p] → [IsAlgClosed K] → {g : ℕ} → SupersingularCurves.Geometry.AbelianVariety K g → Prop :=
fun {K} [Field K] p [Fact (Nat.Prime p)] [CharP K p] [IsAlgClosed K] {g} A =>
  ∃ E,
    (∀ (i : Fin g), SupersingularCurves.Geometry.AbelianVariety.IsSupersingularElliptic p (E i)) ∧
      Nonempty (A.group ≅ SupersingularCurves.Geometry.ellipticProduct E)
