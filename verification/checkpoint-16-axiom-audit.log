  [inst : Field K] → {G H : SupersingularCurves.Geometry.GroupScheme K} → (G ⟶ H) → Prop :=
fun {K} [Field K] {G H} f =>
  AlgebraicGeometry.IsFinite (SupersingularCurves.Geometry.underlyingScheme.map f) ∧
    AlgebraicGeometry.Surjective (SupersingularCurves.Geometry.underlyingScheme.map f)
