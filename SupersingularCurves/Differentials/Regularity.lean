import SupersingularCurves.Differentials.Hyperelliptic

/-!
# Regular hyperelliptic differentials at actual places

Regularity is membership in the valuation-ring lattice generated by a local
uniformizer differential. For a separable equation y² = f(x), a Bezout identity
for f and f' makes dx/y regular at every place where x is integral. A second
chart with coordinates u = 1/x and z = y/x³ treats infinity.
-/

set_option autoImplicit false
noncomputable section

namespace SupersingularCurves.Differentials

open AlgebraicCurve KaehlerDifferential Polynomial
open P2MW.S_AlgebraicCurve_Place_isRegularAt_and_hasSimplePoleAt_and_hasSimpleResidue_of_cartierLaws_of_finiteDimensional.CartierLocalPen12

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- An integral scalar preserves the actual local regular-differential lattice. -/
theorem regularAt_smul_integral (v : Place K F) {a : F}
    (ha : a ∈ v.toValuationSubring) {ω : Ω[F⁄K]} (hω : v.IsRegularAt ω) :
    v.IsRegularAt (a • ω) := by
  obtain ⟨b, hb, rfl⟩ := hω
  exact ⟨a * b, mul_mem ha hb, by rw [mul_smul]⟩

theorem aeval_mem_of_integral (v : Place K F) {x : F}
    (hx : x ∈ v.toValuationSubring) (f : K[X]) :
    aeval x f ∈ v.toValuationSubring := by
  rw [aeval_eq_sum_range' (show f.natDegree < f.natDegree + 1 by omega) x]
  apply sum_mem
  intro n _
  simpa only [Algebra.smul_def] using
    mul_mem (v.algebraMap_mem' (f.coeff n)) (pow_mem hx n)

/-- Valuation rings contain any square root in their fraction field of an integral element. -/
theorem mem_of_sq_mem (v : Place K F) {y : F}
    (hy : y ^ 2 ∈ v.toValuationSubring) : y ∈ v.toValuationSubring := by
  have ho := ord_nonneg_of_mem v hy
  rw [show y ^ 2 = y ^ (2 : ℤ) by simp, v.ord_zpow] at ho
  exact mem_of_ord_nonneg v (by omega)

variable [PerfectField K] [IsCurveOver K F]
  (s : F) [FiniteDimensional (IntermediateField.adjoin K {s}) F]

include s in
/-- Differentiating an integral function gives a locally regular differential. -/
theorem regularAt_D_of_integral (v : Place K F) {a : F}
    (ha : a ∈ v.toValuationSubring) : v.IsRegularAt (D K F a) := by
  have hdt := AlgebraicCurve.Place.kaehlerD_ne_zero_of_ord_eq_one s v v.ord_uniformizer
  obtain ⟨b, hb⟩ := exists_coeff hdt (D K F a)
  refine ⟨b, mem_of_ord_nonneg v ?_, ?_⟩
  · exact AlgebraicCurve.Place.ord_nonneg_of_D_eq_smul_D_of_ord_eq_one s v v.ord_uniformizer
      (ord_nonneg_of_mem v ha) hb
  · simpa only [v.dCoord_eq] using hb

omit [PerfectField K] [IsCurveOver K F] in
/-- The differentiated equation; this is an identity in the actual Kähler module. -/
theorem hyperelliptic_differential_relation (x y : F) (f : K[X])
    (hy : y ^ 2 = aeval x f) :
    aeval x f.derivative • D K F x = (2 * y) • D K F y := by
  have h := congrArg (D K F) hy
  simpa [Derivation.map_aeval, Derivation.leibniz_pow, two_smul,
    add_smul, mul_smul] using h.symm

include s in
/-- Bezout removes the apparent denominator at every finite point, including branch points. -/
theorem regularAt_dx_div_y_of_integral (v : Place K F) (x y : F)
    (f : K[X]) (hf : f.Separable) (hy : y ^ 2 = aeval x f) (hy0 : y ≠ 0)
    (hx : x ∈ v.toValuationSubring) : v.IsRegularAt (y⁻¹ • D K F x) := by
  obtain ⟨a, b, hab⟩ := hf
  have hyint : y ∈ v.toValuationSubring :=
    mem_of_sq_mem v (hy ▸ aeval_mem_of_integral v hx f)
  have he : aeval x a * y ^ 2 + aeval x b * aeval x f.derivative = 1 := by
    have h := congrArg (aeval x) hab
    simpa only [map_add, map_mul, map_one, ← hy] using h
  have hd := hyperelliptic_differential_relation x y f hy
  have hid : y⁻¹ • D K F x =
      (aeval x a * y) • D K F x + (2 * aeval x b) • D K F y := by
    calc
      _ = (y⁻¹ * (aeval x a * y ^ 2 + aeval x b * aeval x f.derivative)) • D K F x := by
        rw [he, mul_one]
      _ = (aeval x a * y) • D K F x +
          (y⁻¹ * aeval x b) • (aeval x f.derivative • D K F x) := by
        rw [mul_add, add_smul, ← mul_smul]
        congr 1
        · congr 1
          field_simp
        · rw [mul_assoc]
      _ = _ := by
        rw [hd, ← mul_smul]
        congr 1
        congr 1
        field_simp
  rw [hid]
  apply AlgebraicCurve.Place.IsRegularAt.add
  · exact regularAt_smul_integral v
      (mul_mem (aeval_mem_of_integral v hx a) hyint) (regularAt_D_of_integral s v hx)
  · exact regularAt_smul_integral v
      (mul_mem (by simpa using v.algebraMap_mem' (2 : K))
        (aeval_mem_of_integral v hx b)) (regularAt_D_of_integral s v hyint)

omit [PerfectField K] [IsCurveOver K F] in
/-- On the reciprocal chart u = 1/x, z = y/x³, the forms become -u du/z and -du/z. -/
theorem reciprocal_differential_identities (x y : F) (hx0 : x ≠ 0) :
    y⁻¹ • D K F x = (-x⁻¹) • ((y * x⁻¹ ^ 3)⁻¹ • D K F x⁻¹) ∧
    x • (y⁻¹ • D K F x) = -( (y * x⁻¹ ^ 3)⁻¹ • D K F x⁻¹) := by
  rw [Derivation.leibniz_inv]
  simp only [mul_inv_rev, inv_pow, inv_inv, smul_smul, ← neg_smul]
  constructor <;> congr 1 <;> field_simp

include s in
/-- Two separable charts prove regularity at all places, including infinity. -/
theorem hyperelliptic_pair_mem_regularDifferentials (x y : F) (f g : K[X])
    (hf : f.Separable) (hg : g.Separable)
    (hy : y ^ 2 = aeval x f) (hrecip : (y * x⁻¹ ^ 3) ^ 2 = aeval x⁻¹ g)
    (hx0 : x ≠ 0) (hy0 : y ≠ 0) :
    y⁻¹ • D K F x ∈ regularDifferentials K F ∧
      x • (y⁻¹ • D K F x) ∈ regularDifferentials K F := by
  have hlocal : ∀ v : Place K F, v.IsRegularAt (y⁻¹ • D K F x) ∧
      v.IsRegularAt (x • (y⁻¹ • D K F x)) := by
    intro v
    rcases v.toValuationSubring.mem_or_inv_mem x with hx | hu
    · have hω := regularAt_dx_div_y_of_integral s v x y f hf hy hy0 hx
      exact ⟨hω, regularAt_smul_integral v hx hω⟩
    · have hz0 : y * x⁻¹ ^ 3 ≠ 0 := mul_ne_zero hy0 (pow_ne_zero _ (inv_ne_zero hx0))
      have hω := regularAt_dx_div_y_of_integral s v x⁻¹ (y * x⁻¹ ^ 3) g hg hrecip hz0 hu
      obtain ⟨h0, h1⟩ := reciprocal_differential_identities (K := K) x y hx0
      constructor
      · rw [h0]
        exact regularAt_smul_integral v (neg_mem hu) hω
      · rw [h1]
        simpa using hω.smul (-1 : K)
  exact ⟨fun v => (hlocal v).1, fun v => (hlocal v).2⟩

end SupersingularCurves.Differentials
