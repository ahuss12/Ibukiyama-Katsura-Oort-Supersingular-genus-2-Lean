import Mathlib

/-!
# The length of a one-generator infinitesimal algebra

An augmented algebra whose augmentation ideal is generated by an element x
with x^p = 0 is spanned by the first p powers of x. If an actual derivation
sends x to a unit, then the nilpotency index of x is p, forcing these powers
to be a basis. The derivation is an explicit input to the algebra theorem;
its construction from a group scheme is a separate geometric step.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace SupersingularCurves.Geometry.LocalAlgebraFrobeniusOrder
open Polynomial

variable {K : Type u} [Field K] {A : Type v} [CommRing A] [Algebra K A]

/-- A one-dimensional actual local cotangent space supplies an element
that generates the maximal ideal, by Nakayama. Its cotangent class is nonzero. -/
theorem exists_generator_of_cotangent_finrank_one [IsLocalRing A] [IsNoetherianRing A]
    (hdim : Module.finrank K (IsLocalRing.CotangentSpace A) = 1) :
    ∃ x : IsLocalRing.maximalIdeal A,
      IsLocalRing.maximalIdeal A = Ideal.span {x.1} ∧
      (IsLocalRing.maximalIdeal A).toCotangent x ≠ 0 := by
  obtain ⟨v, hv, hspan⟩ := finrank_eq_one_iff'.mp hdim
  obtain ⟨x, hx⟩ := (IsLocalRing.maximalIdeal A).toCotangent_surjective v
  refine ⟨x, ?_, by simpa only [hx] using hv⟩
  have htop : Submodule.span A {x} = ⊤ := by
    apply IsLocalRing.CotangentSpace.map_eq_top_iff.mp
    rw [Submodule.map_span, Set.image_singleton, hx]
    apply top_unique
    intro w _
    obtain ⟨k, rfl⟩ := hspan w
    rw [← IsScalarTower.algebraMap_smul A k v]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton v))
  have hmap := congrArg (Submodule.map (IsLocalRing.maximalIdeal A).subtype) htop
  simpa only [Submodule.map_span, Set.image_singleton, Submodule.coe_subtype,
    Submodule.map_top, Submodule.range_subtype] using hmap.symm

/-- A nilpotent generator of the augmentation ideal yields an actual finite
spanning family over the residue field. -/
theorem span_powers_eq_top (ε : A →ₐ[K] K) (x : A)
    (hker : RingHom.ker ε.toRingHom = Ideal.span {x})
    (n : ℕ) (hxn : x ^ n = 0) :
    Submodule.span K (Set.range fun i : Fin n => x ^ (i : ℕ)) = ⊤ := by
  have happrox : ∀ m : ℕ, ∀ a : A, ∃ b : A,
      a - x ^ m * b ∈ Submodule.span K (Set.range fun i : Fin m => x ^ (i : ℕ)) := by
    intro m
    induction m with
    | zero => intro a; exact ⟨a, by simp⟩
    | succ m ih =>
      intro a
      obtain ⟨b, hb⟩ := ih a
      have hk : b - algebraMap K A (ε b) ∈ RingHom.ker ε.toRingHom := by simp
      rw [hker, Ideal.mem_span_singleton] at hk
      obtain ⟨c, hc⟩ := hk
      refine ⟨c, ?_⟩
      have hmem : a - x ^ m * b ∈
          Submodule.span K (Set.range fun i : Fin (m + 1) => x ^ (i : ℕ)) := by
        apply Submodule.span_mono (s := Set.range fun i : Fin m => x ^ (i : ℕ)) ?_ hb
        rintro _ ⟨i, rfl⟩
        exact ⟨i.castSucc, rfl⟩
      have hlast : x ^ m ∈
          Submodule.span K (Set.range fun i : Fin (m + 1) => x ^ (i : ℕ)) :=
        Submodule.subset_span ⟨Fin.last m, rfl⟩
      have hsum := (Submodule.span K (Set.range fun i : Fin (m + 1) => x ^ (i : ℕ))).add_mem
        hmem ((Submodule.span K (Set.range fun i : Fin (m + 1) => x ^ (i : ℕ))).smul_mem (ε b) hlast)
      convert hsum using 1
      rw [Algebra.smul_def, pow_succ]
      linear_combination x ^ m * hc
  apply top_unique
  intro a _
  obtain ⟨b, hb⟩ := happrox n a
  simpa only [hxn, zero_mul, sub_zero] using hb

/-- The Frobenius-zero relation gives the unconditional upper bound on the
length once the augmentation ideal has a single generator. -/
theorem finrank_le_of_pow_eq_zero (ε : A →ₐ[K] K) (x : A)
    (hker : RingHom.ker ε.toRingHom = Ideal.span {x})
    (n : ℕ) (hxn : x ^ n = 0) : Module.finrank K A ≤ n := by
  simpa using (finrank_le_of_span_eq_top (span_powers_eq_top ε x hker n hxn))

/-- Over a local augmented algebra, a nonzero augmentation detects a unit. -/
theorem isUnit_of_augmentation_ne_zero [IsLocalRing A] (ε : A →ₐ[K] K)
    (hker : RingHom.ker ε.toRingHom = IsLocalRing.maximalIdeal A)
    {x : A} (hx : ε x ≠ 0) : IsUnit x := by
  apply IsLocalRing.notMem_maximalIdeal.mp
  rwa [← hker, RingHom.mem_ker]

/-- A derivation with unit value forces the nilpotency index to be divisible
by the characteristic; the Frobenius bound makes it exactly p. -/
theorem nilpotencyClass_eq_prime [Nontrivial A]
    (p : ℕ) [Fact p.Prime] [CharP K p] (x : A) (hxp : x ^ p = 0)
    (D : Derivation K A A) (hD : IsUnit (D x)) : nilpotencyClass x = p := by
  have hx : IsNilpotent x := ⟨p, hxp⟩
  have hn : 0 < nilpotencyClass x := pos_nilpotencyClass_iff.mpr hx
  have hle : nilpotencyClass x ≤ p := Nat.sInf_le hxp
  have heq := congrArg D (pow_nilpotencyClass hx)
  rw [map_zero, D.leibniz_pow, nsmul_eq_mul, smul_eq_mul] at heq
  have hz : (nilpotencyClass x : K) • x ^ (nilpotencyClass x - 1) = 0 := by
    apply (hD.mul_right_eq_zero).mp
    simpa only [Algebra.smul_def, map_natCast, mul_assoc, mul_comm, mul_left_comm] using heq
  have hcast : (nilpotencyClass x : K) = 0 :=
    (smul_eq_zero.mp hz).resolve_right (pow_pred_nilpotencyClass hx)
  have hdvd : p ∣ nilpotencyClass x := (CharP.cast_eq_zero_iff K p _).mp hcast
  exact le_antisymm hle (Nat.le_of_dvd hn hdvd)

/-- The exact monic minimal polynomial of an element with x^p = 0 whose
unit-valued derivation detects the full nilpotency index. -/
theorem minpoly_eq_X_pow_prime [Nontrivial A]
    (p : ℕ) [Fact p.Prime] [CharP K p] (x : A) (hxp : x ^ p = 0)
    (D : Derivation K A A) (hD : IsUnit (D x)) : minpoly K x = X ^ p := by
  have hi : IsIntegral K x := ⟨X ^ p, monic_X_pow p, by simpa using hxp⟩
  have hdvd : minpoly K x ∣ X ^ p := minpoly.dvd K x (by simpa using hxp)
  obtain ⟨m, hm, hma⟩ := (dvd_prime_pow (prime_X (R := K)) p).mp hdvd
  have heq : minpoly K x = X ^ m := eq_of_monic_of_associated (minpoly.monic hi) (monic_X_pow m) hma
  have hxm : x ^ m = 0 := by simpa only [heq, map_pow, aeval_X] using minpoly.aeval K x
  have hp : p ≤ m := by
    rw [← nilpotencyClass_eq_prime p x hxp D hD]
    exact Nat.sInf_le hxm
  have hmp : m = p := le_antisymm hm hp
  simpa only [hmp] using heq

/-- Exact vector-space length p from a principal Frobenius-zero augmentation
ideal and a unit-valued derivation. -/
theorem finrank_eq_prime [Nontrivial A] [Module.Finite K A]
    (p : ℕ) [Fact p.Prime] [CharP K p]
    (ε : A →ₐ[K] K) (x : A)
    (hker : RingHom.ker ε.toRingHom = Ideal.span {x}) (hxp : x ^ p = 0)
    (D : Derivation K A A) (hD : IsUnit (D x)) : Module.finrank K A = p := by
  have hlin : LinearIndependent K (fun i : Fin p => x ^ (i : ℕ)) := by
    have h := linearIndependent_pow (K := K) x
    have hdeg : (minpoly K x).natDegree = p := by
      rw [minpoly_eq_X_pow_prime p x hxp D hD, natDegree_X_pow]
    exact h.comp (finCongr hdeg.symm) (finCongr hdeg.symm).injective
  let b := Module.Basis.mk hlin (by rw [span_powers_eq_top ε x hker p hxp])
  simpa using Module.finrank_eq_card_basis b


/-- The order-p conclusion with the generator and nilpotency hypotheses
supplied by actual local cotangent dimension and Frobenius vanishing. The
last input is explicitly the existence of a detecting derivation, not an
assumed order or classification. -/
theorem finrank_eq_prime_of_cotangent_dimension_one
    [IsLocalRing A] [IsNoetherianRing A] [Module.Finite K A]
    (p : ℕ) [Fact p.Prime] [CharP K p] (ε : A →ₐ[K] K)
    (hker : RingHom.ker ε.toRingHom = IsLocalRing.maximalIdeal A)
    (hdim : Module.finrank K (IsLocalRing.CotangentSpace A) = 1)
    (hF : ∀ x : IsLocalRing.maximalIdeal A, (x : A) ^ p = 0)
    (hder : ∀ x : IsLocalRing.maximalIdeal A,
      (IsLocalRing.maximalIdeal A).toCotangent x ≠ 0 →
      ∃ D : Derivation K A A, ε (D x) ≠ 0) : Module.finrank K A = p := by
  obtain ⟨x, hx, hx0⟩ := exists_generator_of_cotangent_finrank_one hdim
  obtain ⟨D, hD⟩ := hder x hx0
  exact finrank_eq_prime p ε x (hker.trans hx) (hF x) D
    (isUnit_of_augmentation_ne_zero ε hker hD)

end SupersingularCurves.Geometry.LocalAlgebraFrobeniusOrder
