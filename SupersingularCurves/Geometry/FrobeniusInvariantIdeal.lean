import Theorems.Thm_Submodule_span_fixedPoints_eq_top_of_frobenius_semilinear_injective

/-!
# Descent of Frobenius-stable polynomial ideals

An ideal in a polynomial ring over an algebraically closed field, stable under
coefficient Frobenius, is generated by equations over the finite fixed field.
The proof applies Frobenius fixed-vector spanning to each finite-dimensional
bounded-degree part of the ideal. This is a coordinate descent theorem; its
application to a variety requires an actual invariant presentation.
-/

set_option autoImplicit false
noncomputable section
universe u v

namespace SupersingularCurves.Geometry.FrobeniusDescent

open MvPolynomial

variable (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p] (s : ℕ)

/-- The actual subfield fixed by the s-fold field Frobenius. -/
def fixedField : Subfield K :=
  (iterateFrobenius K p s).eqLocusField (RingHom.id K)

@[simp] theorem mem_fixedField (a : K) :
    a ∈ fixedField K p s ↔ a ^ (p ^ s) = a := Iff.rfl

/-- For positive s, the fixed coefficient field is finite. -/
theorem fixedField_finite (hs : s ≠ 0) : Finite (fixedField K p s) := by
  have hne : (Polynomial.X ^ (p ^ s) - Polynomial.X : Polynomial K) ≠ 0 :=
    FiniteField.X_pow_card_pow_sub_X_ne_zero K hs (Fact.out : p.Prime).one_lt
  have hfin := Polynomial.finite_setOfPred_isRoot hne
  have hset : (fixedField K p s : Set K) =
      {a : K | Polynomial.IsRoot (Polynomial.X ^ (p ^ s) - Polynomial.X) a} := by
    ext a
    simp [Polynomial.IsRoot, sub_eq_zero]
  exact (hset ▸ hfin).to_subtype

/-- In an algebraically closed field, the fixed field has exactly p^s elements. -/
theorem fixedField_natCard [IsAlgClosed K] (hs : s ≠ 0) :
    Nat.card (fixedField K p s) = p ^ s := by
  classical
  let f : Polynomial K := Polynomial.X ^ (p ^ s) - Polynomial.X
  have hne : f ≠ 0 :=
    FiniteField.X_pow_card_pow_sub_X_ne_zero K hs (Fact.out : p.Prime).one_lt
  have hsep : f.Separable := by
    simp only [f, Polynomial.separable_def, Polynomial.derivative_sub,
      Polynomial.derivative_X_pow, Nat.cast_pow, CharP.cast_eq_zero K p,
      zero_pow hs, map_zero, zero_mul, Polynomial.derivative_X, zero_sub]
    exact isCoprime_one_right.neg_right
  have hset : (fixedField K p s : Set K) = f.rootSet K := by
    ext a
    simp [Polynomial.mem_rootSet, hne, f, sub_eq_zero]
  change Nat.card ↥(fixedField K p s : Set K) = _
  rw [Nat.card_congr (Equiv.setCongr hset), Nat.card_eq_fintype_card]
  rw [Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)]
  exact FiniteField.X_pow_card_pow_sub_X_natDegree_eq K hs (Fact.out : p.Prime).one_lt

variable {K} {σ : Type v}

/-- Frobenius acts on coefficients while fixing the polynomial variables. -/
def coefficientFrobenius : MvPolynomial σ K →+* MvPolynomial σ K :=
  MvPolynomial.map (iterateFrobenius K p s)

@[simp] theorem coeff_coefficientFrobenius (f : MvPolynomial σ K) (m : σ →₀ ℕ) :
    coeff m (coefficientFrobenius p s f) = (coeff m f) ^ (p ^ s) := by
  change coeff m (MvPolynomial.map (iterateFrobenius K p s) f) = _
  rw [MvPolynomial.coeff_map]
  rfl

/-- A polynomial is fixed exactly when it comes from the actual fixed subfield. -/
theorem fixedPolynomial_iff_definedOver (f : MvPolynomial σ K) :
    coefficientFrobenius p s f = f ↔
      ∃ g : MvPolynomial σ (fixedField K p s),
        MvPolynomial.map (fixedField K p s).subtype g = f := by
  constructor
  · intro hf
    apply (MvPolynomial.mem_range_map_iff_coeffs_subset).mpr
    intro a ha
    obtain ⟨m, _, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp ha
    refine ⟨⟨coeff m f, ?_⟩, rfl⟩
    exact congrArg (coeff m) hf
  · rintro ⟨g, rfl⟩
    ext m
    simp only [coeff_coefficientFrobenius, MvPolynomial.coeff_map]
    exact (coeff m g).property

variable [IsAlgClosed K] [Finite σ]

private abbrev boundedIdeal (I : Ideal (MvPolynomial σ K)) (d : ℕ) :
    Submodule K (MvPolynomial σ K) :=
  I.restrictScalars K ⊓ MvPolynomial.restrictTotalDegree σ K d

private def boundedIdealFrobenius (I : Ideal (MvPolynomial σ K))
    (hI : ∀ f ∈ I, coefficientFrobenius p s f ∈ I) (d : ℕ) :
    boundedIdeal I d →+ boundedIdeal I d where
  toFun f := ⟨coefficientFrobenius p s f, hI f f.property.1,
    (MvPolynomial.mem_restrictTotalDegree σ d _).mpr
      ((MvPolynomial.totalDegree_le_of_support_subset
        (MvPolynomial.support_map_subset _ _)).trans
          ((MvPolynomial.mem_restrictTotalDegree σ d _).mp f.property.2))⟩
  map_zero' := Subtype.ext (map_zero _)
  map_add' _f _g := Subtype.ext (map_add _ _ _)

omit [IsAlgClosed K] [Finite σ] in
private theorem boundedIdealFrobenius_semilinear (I : Ideal (MvPolynomial σ K))
    (hI : ∀ f ∈ I, coefficientFrobenius p s f ∈ I) (d : ℕ)
    (c : K) (f : boundedIdeal I d) :
    boundedIdealFrobenius p s I hI d (c • f) =
      c ^ (p ^ s) • boundedIdealFrobenius p s I hI d f := by
  apply Subtype.ext
  change MvPolynomial.map (iterateFrobenius K p s) (c • (f : MvPolynomial σ K)) =
    c ^ (p ^ s) • MvPolynomial.map (iterateFrobenius K p s) (f : MvPolynomial σ K)
  simp only [← MvPolynomial.C_mul', map_mul, MvPolynomial.map_C]
  rfl

/-- Each bounded-degree part of a stable ideal is spanned by fixed equations. -/
private theorem boundedIdeal_span_fixed (hs : s ≠ 0) (I : Ideal (MvPolynomial σ K))
    (hI : ∀ f ∈ I, coefficientFrobenius p s f ∈ I) (d : ℕ) :
    Submodule.span K (Function.fixedPoints (boundedIdealFrobenius p s I hI d)) = ⊤ := by
  let e : boundedIdeal I d →ₗ[K] MvPolynomial.restrictTotalDegree σ K d :=
    Submodule.inclusion inf_le_right
  have : FiniteDimensional K (boundedIdeal I d) :=
    FiniteDimensional.of_injective e (Submodule.inclusion_injective inf_le_right)
  apply Submodule.span_fixedPoints_eq_top_of_frobenius_semilinear_injective s hs
    (boundedIdealFrobenius p s I hI d)
    (boundedIdealFrobenius_semilinear p s I hI d)
  intro f g hfg
  apply Subtype.ext
  exact MvPolynomial.map_injective _ (RingHom.injective (iterateFrobenius K p s))
    (congrArg Subtype.val hfg)

/-- Frobenius stability descends the entire ideal to the finite coefficient field. -/
theorem ideal_map_comap_eq (hs : s ≠ 0) (I : Ideal (MvPolynomial σ K))
    (hI : ∀ f ∈ I, coefficientFrobenius p s f ∈ I) :
    Ideal.map (MvPolynomial.map (fixedField K p s).subtype)
      (Ideal.comap (MvPolynomial.map (fixedField K p s).subtype) I) = I := by
  apply le_antisymm (Ideal.map_comap_le)
  intro f hf
  let J := Ideal.map (MvPolynomial.map (fixedField K p s).subtype)
    (Ideal.comap (MvPolynomial.map (fixedField K p s).subtype) I)
  let v : boundedIdeal I f.totalDegree :=
    ⟨f, hf, (MvPolynomial.mem_restrictTotalDegree σ f.totalDegree f).mpr le_rfl⟩
  have hv : v ∈ Submodule.span K
      (Function.fixedPoints (boundedIdealFrobenius p s I hI f.totalDegree)) := by
    rw [boundedIdeal_span_fixed p s hs I hI]
    trivial
  suffices ∀ w ∈ Submodule.span K
      (Function.fixedPoints (boundedIdealFrobenius p s I hI f.totalDegree)),
      (w : MvPolynomial σ K) ∈ J from this v hv
  intro w hw
  induction hw using Submodule.span_induction with
  | mem w hw =>
      have hfixed : coefficientFrobenius p s (w : MvPolynomial σ K) = w :=
        congrArg Subtype.val hw
      obtain ⟨g, hg⟩ := (fixedPolynomial_iff_definedOver p s (w : MvPolynomial σ K)).mp hfixed
      rw [← hg]
      apply Ideal.mem_map_of_mem
      change MvPolynomial.map (fixedField K p s).subtype g ∈ I
      rw [hg]
      exact w.property.1
  | zero => exact J.zero_mem
  | add x y _ _ hx hy => exact J.add_mem hx hy
  | smul c x _ hx =>
      change c • (x : MvPolynomial σ K) ∈ J
      exact (J.restrictScalars K).smul_mem c hx

end SupersingularCurves.Geometry.FrobeniusDescent
